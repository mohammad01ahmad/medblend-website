# Server-side only — set in the Vercel project settings, never commit real values.

# Supabase.
#  - URL + SERVICE_ROLE_KEY: service-role client (lib/supabase.ts) — API routes,
#    scripts, and the /admin dashboard's data reads.
#  - URL + PUBLISHABLE_KEY: cookie session client (lib/supabase/*) — the /admin
#    Google sign-in and the admin allow-list check (public.admin_users).
# NOTE: the live deploy currently reads these as NEXT_PUBLIC_SUPABASE_* (see
# lib/supabase.ts) — a NEXT_PUBLIC_ prefix on the service-role key is a footgun;
# keep that client server-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
# /admin Google OAuth needs no client id/secret here — it uses Supabase Auth's
# Google provider (already configured). One manual step: in the Supabase
# dashboard, Auth → URL Configuration → Redirect URLs, add
# http://localhost:3000/auth/callback and https://<prod-domain>/auth/callback.

# Medical Journey RAG pipeline (lib/journey/*, app/api/journey/*, scripts/ingest.ts).
# One OpenRouter key covers embeddings, generation, and reranking.
OPENROUTER_API_KEY=
# Generation model — must support `response_format: json_schema` (e.g. anthropic/claude-sonnet-4.5,
# openai/gpt-4.1). Required. `openrouter/free` is the $0 option: a router that picks a free
# model and filters for structured-output support — slower, quality varies run to run.
JOURNEY_GEN_MODEL=
# Reranker model. Optional — defaults to cohere/rerank-4-fast. Override to test
# cohere/rerank-v3.5 or cohere/rerank-4-pro.
JOURNEY_RERANK_MODEL=
# Gates the write path on POST /api/journey/generate?refresh=1 (re-generating a milestone
# that already has a row). Any random string; sent as the `x-admin-secret` header.
JOURNEY_ADMIN_SECRET=
# Langfuse (deferred — rag_runs is the first-party record for V1): LANGFUSE_PUBLIC_KEY,
# LANGFUSE_SECRET_KEY, LANGFUSE_BASEURL.

# PDF → markdown transcription (scripts/transcribe-pdf.ts) — Google AI Studio key, separate
# from OpenRouter. Gemini reads PDF bytes natively.
JOURNEY_PDF_API_KEY=
# Optional — defaults to gemini-flash-latest. The free tier caps daily requests per model
# (gemini-2.5-flash is only 20/day); transcribe-pdf caches each page-batch, so a re-run after
# a quota/503 failure resumes from where it stopped. Enable billing on the Google project to
# lift the cap (~$0.04 for a 50-page doc).
JOURNEY_PDF_MODEL=
